{
  "manifest_version": 3,
  "name": "RepoLens",
  "version": "0.1.0",
  "description": "GitHub のリポジトリの事実を出典つきでコピーし、自分の公開リポジトリをルールで点検する",
  "minimum_chrome_version": "153",
  "permissions": ["activeTab", "offscreen", "storage"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "action": { "default_title": "RepoLens", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "copy-repo": { "suggested_key": { "default": "Alt+Shift+G" }, "description": "このリポジトリを既定の形でコピー" }
  }
}
